modules = ["nodejs-20", "web"]
run = "bun run dev"

[nix]
channel = "stable-24_05"

[deployment]
run = ["sh", "-c", "bun run start"]
build = ["sh", "-c", "bun run build"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 5173
externalPort = 80
exposeLocalhost = true
