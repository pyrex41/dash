# ===================================
# Insurance Dashboard - Environment Variables
# ===================================
# Copy this file to .env and fill in your actual credentials
# IMPORTANT: Both backend and frontend require separate variables (VITE_ prefix for frontend)

# -----------------------------------
# Database Configuration
# -----------------------------------
# Turso (LibSQL) Database - Backend
TURSO_DATABASE_URL=libsql://your-database-name.turso.io
TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Turso (LibSQL) Database - Frontend (Vite requires VITE_ prefix)
VITE_TURSO_DATABASE_URL=libsql://your-database-name.turso.io
VITE_TURSO_AUTH_TOKEN=your_turso_auth_token_here

# Local SQLite for development (optional)
# TURSO_DATABASE_URL=file:./backend/csg.db

# -----------------------------------
# LAPro (Lead Advantage Pro) API
# -----------------------------------
# LAPro API credentials - Backend
LAPRO_USERNAME=your_lapro_username
LAPRO_PASSWORD=your_lapro_password
LAPRO_GRANT_TYPE=password
LAPRO_CLIENT_ID=your_lapro_client_id
LAPRO_CLIENT_SECRET=your_lapro_client_secret

# LAPro API credentials - Frontend (Vite requires VITE_ prefix)
VITE_LAPRO_USERNAME=your_lapro_username
VITE_LAPRO_PASSWORD=your_lapro_password
VITE_LAPRO_GRANT_TYPE=password
VITE_LAPRO_CLIENT_ID=your_lapro_client_id
VITE_LAPRO_CLIENT_SECRET=your_lapro_client_secret

# -----------------------------------
# CSG (CSG Actuarial) API
# -----------------------------------
# CSG API credentials - Backend
CSG_API_URL=https://csgapi.appspot.com
CSG_API_KEY=your_csg_api_key_here
CSG_USERNAME=your_csg_username
CSG_PASSWORD=your_csg_password

# -----------------------------------
# HubSpot Integration
# -----------------------------------
# HubSpot API Configuration - Backend
HUBSPOT_API_KEY=your_hubspot_api_key_here
HUBSPOT_PORTAL_ID=your_hubspot_portal_id

# HubSpot Sync Settings - Backend
HUBSPOT_CONTACT_SYNC_ENABLED=true        # Enable/disable HubSpot contact syncing
HUBSPOT_MOCK_API=false                   # true=mock mode (safe testing), false=real API calls
HUBSPOT_RATE_LIMIT_DELAY=100            # Delay between requests in milliseconds (default: 100ms)
HUBSPOT_SYNC_INTERVAL_MS=300000         # Auto-sync interval in milliseconds (default: 5 minutes)
HUBSPOT_SYNC_BATCH_SIZE=10              # Number of bookings to sync per batch (default: 10)

# HubSpot Configuration - Frontend (Vite requires VITE_ prefix)
VITE_HUBSPOT_CONTACT_SYNC_ENABLED=true   # Show/hide HubSpot sync controls in UI
VITE_HUBSPOT_MOCK_API=false              # Display mock mode indicator in UI

# -----------------------------------
# Application Login
# -----------------------------------
# Dashboard login credentials - Backend
LOGIN=your_dashboard_username
PASSWORD=your_dashboard_password

# Dashboard login credentials - Frontend (Vite requires VITE_ prefix)
VITE_LOGIN=your_dashboard_username
VITE_PASSWORD=your_dashboard_password

# -----------------------------------
# Server Configuration
# -----------------------------------
PORT=3000                               # Backend server port
NODE_ENV=development                     # development or production
VITE_API_WS_URL=/ws                     # WebSocket endpoint for frontend

# SSL Configuration (optional, for production)
# SSL_CERT=/path/to/cert.pem
# SSL_KEY=/path/to/key.pem

# -----------------------------------
# Additional Configuration
# -----------------------------------
# Optional: Format server URL
# FORMAT_SERVER_URL=https://your-format-server.com

# ===================================
# IMPORTANT NOTES
# ===================================
#
# 1. DEVELOPMENT vs PRODUCTION:
#    - Development: Set HUBSPOT_MOCK_API=true to test without affecting real HubSpot data
#    - Production: Set HUBSPOT_MOCK_API=false carefully - this creates real contacts
#
# 2. CUSTOM PROPERTIES:
#    - Before syncing, create custom properties in HubSpot portal (see config/hubspot-properties.json)
#    - Custom properties: booking_id, medicare_effective_date
#
# 3. DATA MAPPING:
#    - Property mappings are configured in config/hubspot-properties.json
#    - See config/hubspot-config.ts for validation rules
#
# 4. SYNC SETTINGS:
#    - HUBSPOT_SYNC_INTERVAL_MS: Time between automatic sync cycles (default: 5 minutes)
#    - HUBSPOT_SYNC_BATCH_SIZE: Bookings processed per batch (respect rate limits)
#    - HUBSPOT_RATE_LIMIT_DELAY: Delay between API requests
#
# 5. VITE_ PREFIX:
#    - All frontend environment variables MUST have VITE_ prefix
#    - Duplicate variables without prefix for backend access
#    - Example: HUBSPOT_API_KEY (backend) + VITE_HUBSPOT_API_KEY (frontend)
